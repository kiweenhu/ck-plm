# 复制成 .env 后再按需要修改：cp .env.example .env
# 这一份只是「能跑起来」的默认值，公开部署前请务必改掉数据库口令。

# ---- 数据库 ----
DB_NAME=ck_plm
DB_USERNAME=plm
DB_PASSWORD=plm_pass_2026

# ---- 前端对外端口 ----
WEB_PORT=8080

# ---- JVM 堆 ----
# 小内存机器（2GB）可以把 -Xmx 降到 512m；4GB 以上给到 1g 更从容
JAVA_OPTS=-Xms256m -Xmx768m

# ---- CK-PLM 助手（可选，不配则入口照常显示，只是回答里说明「还没接上」）----
# 凭据一律走环境变量，不要写进受版本控制的 application.yml
# PLM_AI_DEEPSEEK_API_KEY=
