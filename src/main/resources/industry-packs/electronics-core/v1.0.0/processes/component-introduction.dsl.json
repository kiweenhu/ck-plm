{
  "key": "component-introduction",
  "name": "元器件引入流程",
  "displayName": "元器件引入（认定）流程",
  "category": "元器件",
  "description": "电子行业通用的元器件引入与认定流程：需求与选型初审 → 寻源与样品 → 来料检验 → 样品验证（电气+可靠性会签） → 小批量试产验证 → 认定评审（会签，一票否决） → 入库与 AVL 发布。任一审批可驳回至发起人重走。",
  "enabled": true,
  "dsl": {
    "dslVersion": "1.0",
    "meta": {
      "key": "component-introduction",
      "name": "元器件引入流程",
      "displayName": "元器件引入（认定）流程",
      "category": "电子行业",
      "description": "电子行业通用的元器件引入与认定流程：需求与选型初审 → 寻源与样品 → 来料检验 → 样品验证（电气+可靠性会签） → 小批量试产验证 → 认定评审（会签，一票否决） → 入库与 AVL 发布。任一审批可驳回至发起人重走。"
    },
    "variables": [],
    "nodes": [
      {
        "id": "start_1",
        "name": "开始：元器件引入申请",
        "type": "START",
        "initiator": {
          "strategy": "INITIATOR"
        },
        "formRef": "component-qualification-apply"
      },
      {
        "id": "n_demand",
        "name": "需求与选型初审",
        "description": "硬件主管或元器件工程师确认需求合理性与初步选型方案",
        "type": "APPROVAL",
        "assignee": {
          "strategy": "ROLE",
          "roleCodes": [
            "HARDWARE_LEAD",
            "COMPONENT_ENGINEER"
          ]
        },
        "approvalMode": "SINGLE",
        "commentRequired": true,
        "formRef": "component-qualification-review"
      },
      {
        "id": "n_sourcing",
        "name": "寻源与样品申请",
        "description": "供应商寻源、报价与样品获取，评估供应风险与生命周期",
        "type": "TASK",
        "assignee": {
          "strategy": "ROLE",
          "roleCodes": [
            "SOURCING_ENGINEER"
          ]
        },
        "formRef": "component-qualification-review"
      },
      {
        "id": "n_iqc",
        "name": "样品来料检验（IQC）",
        "description": "样品外观、尺寸与标识检验，出具检验结论",
        "type": "APPROVAL",
        "assignee": {
          "strategy": "ROLE",
          "roleCodes": [
            "IQC_ENGINEER"
          ]
        },
        "approvalMode": "SINGLE",
        "commentRequired": true,
        "formRef": "component-qualification-review"
      },
      {
        "id": "n_verify",
        "name": "样品验证（电气 + 可靠性）",
        "description": "电气特性验证与可靠性/环境试验，两项结论会签通过",
        "type": "COUNTERSIGN_APPROVAL",
        "assignee": {
          "strategy": "ROLE",
          "roleCodes": [
            "HARDWARE_ENGINEER",
            "RELIABILITY_ENGINEER"
          ]
        },
        "passRule": {
          "mode": "PERCENT",
          "percent": 100
        },
        "commentRequired": true,
        "formRef": "component-qualification-countersign"
      },
      {
        "id": "n_pilot",
        "name": "小批量试产验证",
        "description": "试产验证可制造性、可焊性与工艺窗口，输出试产结论",
        "type": "TASK",
        "assignee": {
          "strategy": "ROLE",
          "roleCodes": [
            "NPI_ENGINEER"
          ]
        },
        "formRef": "component-qualification-review"
      },
      {
        "id": "n_ce_review",
        "name": "元器件认定评审（会签）",
        "description": "元器件工程师牵头，硬件/品质/可靠性/工艺共同评审；一票否决",
        "type": "COUNTERSIGN_APPROVAL",
        "assignee": {
          "strategy": "ROLE",
          "roleCodes": [
            "COMPONENT_ENGINEER",
            "IQC_ENGINEER",
            "RELIABILITY_ENGINEER",
            "NPI_ENGINEER",
            "HARDWARE_LEAD"
          ]
        },
        "passRule": {
          "mode": "VETO",
          "veto": true
        },
        "commentRequired": true,
        "formRef": "component-qualification-countersign"
      },
      {
        "id": "n_publish",
        "name": "入库与 AVL 发布",
        "description": "建档编码、资料归档，发布到 AVL 与优选库",
        "type": "TASK",
        "assignee": {
          "strategy": "ROLE",
          "roleCodes": [
            "COMPONENT_LIBRARIAN"
          ]
        },
        "formRef": "component-qualification-review"
      },
      {
        "id": "n_end",
        "name": "结束：引入完成",
        "type": "END"
      },
      {
        "id": "set_assignee_emt11t",
        "name": "设置审批人",
        "type": "SET_ASSIGNEE",
        "assignee": {
          "strategy": "INITIATOR"
        },
        "formRef": "CKPLM_SETUP_ASSIGNEE"
      },
      {
        "id": "service_p7h86n",
        "name": "审核中",
