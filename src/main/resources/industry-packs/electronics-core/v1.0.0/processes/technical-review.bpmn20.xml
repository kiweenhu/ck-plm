<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:ckplm="http://www.ck.com/plm/workflow/dsl"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath"
             targetNamespace="http://www.ck.com/plm/workflow">
  <process id="technical-review" name="技术评审流程" isExecutable="true">
    <documentation>通用技术评审流程：发起与材料准备 → 检查项逐条核对 → 问题登记与整改分派 → 整改执行 → 复评 → 结论登记。评审模板来自行业包的 reviews.json。</documentation>
    <startEvent id="start_1" name="开始：评审申请" ckplm:nodeType="START" flowable:initiator="initiator" ckplm:initiator="{&quot;strategy&quot;:&quot;INITIATOR&quot;}" flowable:formKey="technical-review-apply" ckplm:formRef="technical-review-apply"/>
    <userTask id="n_apply" name="材料准备与确认" ckplm:nodeType="TASK" flowable:assignee="${initiator}" ckplm:assignee="{&quot;strategy&quot;:&quot;INITIATOR&quot;}" flowable:formKey="technical-review-apply" ckplm:formRef="technical-review-apply" ckplm:needDeliverables="true" ckplm:deliverableObjectTypes="[&quot;DOCUMENT&quot;]"/>
    <userTask id="set_assignee" name="设置审批人" ckplm:nodeType="SET_ASSIGNEE" flowable:assignee="${initiator}" ckplm:assignee="{&quot;strategy&quot;:&quot;INITIATOR&quot;}" flowable:formKey="CKPLM_SETUP_ASSIGNEE" ckplm:formRef="CKPLM_SETUP_ASSIGNEE"/>
    <userTask id="n_check" name="检查项逐条核对" ckplm:nodeType="APPROVAL" flowable:assignee="${ckplmSetupAssignees_n_check}" ckplm:assignee="{&quot;strategy&quot;:&quot;ROLE&quot;,&quot;roleCodes&quot;:[&quot;QUALITY_ENGINEER&quot;]}" ckplm:approvalMode="&quot;SINGLE&quot;" ckplm:commentRequired="true" flowable:formKey="technical-review-checklist" ckplm:formRef="technical-review-checklist"/>
    <userTask id="n_issue" name="问题登记与整改分派" ckplm:nodeType="TASK" flowable:candidateUsers="${ckplmSetupAssignees_n_issue}" ckplm:assignee="{&quot;strategy&quot;:&quot;ROLE&quot;,&quot;roleCodes&quot;:[&quot;PROJECT_MANAGER&quot;]}" flowable:formKey="technical-review-issue" ckplm:formRef="technical-review-issue"/>
    <userTask id="n_fix" name="等待整改结果，并提交复评" ckplm:nodeType="TASK" flowable:candidateUsers="${ckplmSetupAssignees_n_fix}" ckplm:assignee="{&quot;strategy&quot;:&quot;ROLE&quot;,&quot;roleCodes&quot;:[&quot;PROJECT_MANAGER&quot;]}" flowable:formKey="technical-review-fix" ckplm:formRef="technical-review-fix"/>
    <userTask id="n_reverify" name="复评（评审组）" ckplm:nodeType="COUNTERSIGN_APPROVAL" flowable:assignee="${ckplmApprover}" ckplm:assignee="{&quot;strategy&quot;:&quot;ROLE&quot;,&quot;roleCodes&quot;:[&quot;QUALITY_ENGINEER&quot;,&quot;SYSTEM_ENGINEER&quot;,&quot;HARDWARE_LEAD&quot;]}" ckplm:approvalMode="&quot;COUNTERSIGN&quot;" ckplm:passRule="{&quot;mode&quot;:&quot;PERCENT&quot;,&quot;percent&quot;:100}" ckplm:commentRequired="true" flowable:formKey="technical-review-reverify" ckplm:formRef="technical-review-reverify">  <multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${ckplmSetupAssignees_n_reverify}" flowable:elementVariable="ckplmApprover"><completionCondition>${nrOfCompletedInstances * 100 &gt;= nrOfInstances * 100 || ckplmVetoed}</completionCondition></multiInstanceLoopCharacteristics></userTask>
    <userTask id="n_verdict" name="结论登记（留痕）" ckplm:nodeType="TASK" flowable:candidateUsers="${ckplmSetupAssignees_n_verdict}" ckplm:assignee="{&quot;strategy&quot;:&quot;ROLE&quot;,&quot;roleCodes&quot;:[&quot;PROJECT_MANAGER&quot;]}" flowable:formKey="technical-review-verdict" ckplm:formRef="technical-review-verdict"/>
    <endEvent id="n_end" name="结束：评审完成" ckplm:nodeType="END"/>
    <sequenceFlow id="e0" sourceRef="start_1" targetRef="n_apply"/>
    <sequenceFlow id="e1" sourceRef="n_apply" targetRef="set_assignee"/>
    <sequenceFlow id="e7" sourceRef="set_assignee" targetRef="n_check"/>
    <sequenceFlow id="e2" sourceRef="n_check" targetRef="n_issue"/>
    <sequenceFlow id="e3" sourceRef="n_issue" targetRef="n_fix"/>
    <sequenceFlow id="e4" sourceRef="n_fix" targetRef="n_reverify"/>
    <sequenceFlow id="e5" sourceRef="n_reverify" targetRef="n_verdict"/>
    <sequenceFlow id="e6" sourceRef="n_verdict" targetRef="n_end"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="technical-review">
    <bpmndi:BPMNShape id="Shape_start_1" bpmnElement="start_1">
      <omgdc:Bounds x="296" y="40" width="30" height="30"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_n_apply" bpmnElement="n_apply">
      <omgdc:Bounds x="240" y="150" width="142" height="44"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_set_assignee" bpmnElement="set_assignee">
      <omgdc:Bounds x="240" y="270" width="142" height="44"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_n_check" bpmnElement="n_check">
      <omgdc:Bounds x="240" y="390" width="142" height="44"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_n_issue" bpmnElement="n_issue">
      <omgdc:Bounds x="240" y="510" width="142" height="44"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_n_fix" bpmnElement="n_fix">
      <omgdc:Bounds x="240" y="630" width="142" height="44"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_n_reverify" bpmnElement="n_reverify">
      <omgdc:Bounds x="240" y="750" width="142" height="44"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_n_verdict" bpmnElement="n_verdict">
      <omgdc:Bounds x="240" y="870" width="142" height="44"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_n_end" bpmnElement="n_end">
      <omgdc:Bounds x="296" y="990" width="30" height="30"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Edge_e0" bpmnElement="e0">
      <omgdi:waypoint x="311" y="70"/>
      <omgdi:waypoint x="311" y="150"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_e1" bpmnElement="e1">
      <omgdi:waypoint x="311" y="194"/>
      <omgdi:waypoint x="311" y="270"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_e7" bpmnElement="e7">
      <omgdi:waypoint x="311" y="314"/>
      <omgdi:waypoint x="311" y="390"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_e2" bpmnElement="e2">
      <omgdi:waypoint x="311" y="434"/>
      <omgdi:waypoint x="311" y="510"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_e3" bpmnElement="e3">
      <omgdi:waypoint x="311" y="554"/>
      <omgdi:waypoint x="311" y="630"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_e4" bpmnElement="e4">
      <omgdi:waypoint x="311" y="674"/>
      <omgdi:waypoint x="311" y="750"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_e5" bpmnElement="e5">
      <omgdi:waypoint x="311" y="794"/>
      <omgdi:waypoint x="311" y="870"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_e6" bpmnElement="e6">
      <omgdi:waypoint x="311" y="914"/>
      <omgdi:waypoint x="311" y="990"/>
    </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>