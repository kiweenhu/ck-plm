  <process id="change-task" name="变更任务流程" isExecutable="true" ckplm:variables="[{&quot;name&quot;:&quot;taskAssignee&quot;,&quot;label&quot;:&quot;任务办理人&quot;,&quot;type&quot;:&quot;STRING&quot;,&quot;visible&quot;:true,&quot;readonly&quot;:false}]">
    <documentation>变更任务（ECT）流程：任务下达 → 执行变更任务 → 完成。办理人取自流程变量 taskAssignee。</documentation>
    <startEvent id="start_1" name="开始：任务下达" ckplm:nodeType="START" flowable:initiator="initiator" ckplm:initiator="{&quot;strategy&quot;:&quot;INITIATOR&quot;}"/>
    <userTask id="task_1" name="执行变更任务" ckplm:nodeType="TASK" flowable:assignee="${taskAssignee}" ckplm:assignee="{&quot;strategy&quot;:&quot;VARIABLE&quot;,&quot;variableName&quot;:&quot;taskAssignee&quot;}" flowable:formKey="change-task-execute" ckplm:formRef="change-task-execute"/>
    <endEvent id="end_1" name="结束：任务完成" ckplm:nodeType="END"/>
    <userTask id="set_assignee_dw129e" name="变更结果提交审批" ckplm:nodeType="SET_ASSIGNEE" flowable:assignee="${taskAssignee}" ckplm:assignee="{&quot;strategy&quot;:&quot;VARIABLE&quot;,&quot;variableName&quot;:&quot;taskAssignee&quot;}" flowable:formKey="change-task-approve-setup" ckplm:formRef="change-task-approve-setup"/>
    <userTask id="countersign_approval_g8tm23" name="会签审批" ckplm:nodeType="COUNTERSIGN_APPROVAL" flowable:assignee="${ckplmApprover}" ckplm:assignee="{&quot;strategy&quot;:&quot;ROLE&quot;,&quot;roleCodes&quot;:[&quot;PRODUCT_MANAGER&quot;,&quot;QUALITY_ENGINEER&quot;,&quot;HARDWARE_LEAD&quot;]}" ckplm:approvalMode="&quot;COUNTERSIGN&quot;" ckplm:passRule="{&quot;mode&quot;:&quot;PERCENT&quot;,&quot;percent&quot;:100,&quot;abstain&quot;:&quot;IGNORE&quot;}" flowable:formKey="change-task-countersign" ckplm:formRef="change-task-countersign">  <multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${ckplmSetupAssignees_countersign_approval_g8tm23}" flowable:elementVariable="ckplmApprover"><completionCondition>${nrOfCompletedInstances * 100 &gt;= nrOfInstances * 100 || ckplmVetoed}</completionCondition></multiInstanceLoopCharacteristics></userTask>
    <userTask id="approval_87zopm" name="领导审批" ckplm:nodeType="APPROVAL" flowable:assignee="${ckplmSetupAssignees_approval_87zopm}" ckplm:assignee="{&quot;strategy&quot;:&quot;ROLE&quot;,&quot;roleCodes&quot;:[&quot;COMPANY_LEADER&quot;]}" ckplm:approvalMode="&quot;SINGLE&quot;" flowable:formKey="change-task-approval" ckplm:formRef="change-task-approval"/>
    <serviceTask id="service_kyhaza" name="任务结项" ckplm:nodeType="SERVICE" flowable:delegateExpression="${plmServiceDelegate}" ckplm:serviceRef="change.completeTask">  <extensionElements><flowable:field name="serviceId"><flowable:string>change.completeTask</flowable:string></flowable:field></extensionElements></serviceTask>
    <serviceTask id="service_i1hxoq" name="修订后的对象：评审中" ckplm:nodeType="SERVICE" flowable:delegateExpression="${plmServiceDelegate}" ckplm:serviceRef="object.setLifecycleState" ckplm:serviceParams="{&quot;state&quot;:&quot;REVIEWING&quot;}">  <extensionElements><flowable:field name="serviceId"><flowable:string>object.setLifecycleState</flowable:string></flowable:field><flowable:field name="state"><flowable:string>REVIEWING</flowable:string></flowable:field></extensionElements></serviceTask>
    <serviceTask id="service_z3oh5k" name="修订后的对象：已发布" ckplm:nodeType="SERVICE" flowable:delegateExpression="${plmServiceDelegate}" ckplm:serviceRef="object.setLifecycleState" ckplm:serviceParams="{&quot;state&quot;:&quot;PUBLISHED&quot;}">  <extensionElements><flowable:field name="serviceId"><flowable:string>object.setLifecycleState</flowable:string></flowable:field><flowable:field name="state"><flowable:string>PUBLISHED</flowable:string></flowable:field></extensionElements></serviceTask>
    <sequenceFlow id="e1" sourceRef="start_1" targetRef="task_1"/>
    <sequenceFlow id="flow_1" sourceRef="task_1" targetRef="set_assignee_dw129e"/>
    <sequenceFlow id="flow_3" sourceRef="approval_87zopm" targetRef="countersign_approval_g8tm23"/>
    <sequenceFlow id="flow_5" sourceRef="service_kyhaza" targetRef="end_1"/>
    <sequenceFlow id="flow_2" sourceRef="set_assignee_dw129e" targetRef="service_i1hxoq"/>
    <sequenceFlow id="flow_6" sourceRef="service_i1hxoq" targetRef="approval_87zopm"/>
    <sequenceFlow id="flow_4" sourceRef="countersign_approval_g8tm23" targetRef="service_z3oh5k"/>
    <sequenceFlow id="flow_7" sourceRef="service_z3oh5k" targetRef="service_kyhaza"/>
  </process>
