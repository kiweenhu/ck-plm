             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:ckplm="http://www.ck.com/plm/workflow/dsl"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath"
             targetNamespace="http://www.ck.com/plm/workflow">
  <process id="change-notice-derived" name="变更通告流程（ECR → ECN）" isExecutable="true">
    <documentation>沿用变更请求的审签骨架（分级分流 → 会签 → CCB），只多一道「实施方案审批」：怎么改由本流程定，改什么已由来源 ECR 定。</documentation>
    <startEvent id="start_1" name="开始：发起变更通告" ckplm:nodeType="START" flowable:initiator="initiator" ckplm:initiator="{&quot;strategy&quot;:&quot;INITIATOR&quot;}"/>
    <serviceTask id="set_approving" name="进入审批：审批中" ckplm:nodeType="SERVICE" flowable:delegateExpression="${plmServiceDelegate}" ckplm:serviceRef="change.setRequestStatus" ckplm:serviceParams="{&quot;status&quot;:&quot;APPROVING&quot;}">  <extensionElements><flowable:field name="serviceId"><flowable:string>change.setRequestStatus</flowable:string></flowable:field><flowable:field name="status"><flowable:string>APPROVING</flowable:string></flowable:field></extensionElements></serviceTask>
    <exclusiveGateway id="gw_level" name="按来源变更分级分流" ckplm:nodeType="EXCLUSIVE_GATEWAY" default="e3"/>
    <userTask id="setup_quick" name="设置快速通道审批人" ckplm:nodeType="SET_ASSIGNEE" flowable:assignee="${initiator}" ckplm:assignee="{&quot;strategy&quot;:&quot;INITIATOR&quot;}" flowable:formKey="CKPLM_SETUP_ASSIGNEE" ckplm:formRef="CKPLM_SETUP_ASSIGNEE"/>
    <userTask id="approve_quick" name="快速审批：实施方案" ckplm:nodeType="APPROVAL" flowable:assignee="${ckplmSetupAssignees_approve_quick}" ckplm:assignee="{&quot;strategy&quot;:&quot;INITIATOR&quot;}" ckplm:approvalMode="&quot;SINGLE&quot;" ckplm:commentRequired="true" flowable:formKey="change-notice-review" ckplm:formRef="change-notice-review"/>
    <userTask id="setup_multi" name="设置会签参与人" ckplm:nodeType="SET_ASSIGNEE" flowable:assignee="${initiator}" ckplm:assignee="{&quot;strategy&quot;:&quot;INITIATOR&quot;}" flowable:formKey="CKPLM_SETUP_ASSIGNEE" ckplm:formRef="CKPLM_SETUP_ASSIGNEE"/>
    <userTask id="cs_plan" name="实施方案会签" ckplm:nodeType="COUNTERSIGN_APPROVAL" flowable:assignee="${ckplmApprover}" ckplm:assignee="{&quot;strategy&quot;:&quot;INITIATOR&quot;}" ckplm:approvalMode="&quot;COUNTERSIGN&quot;" ckplm:passRule="{&quot;mode&quot;:&quot;PERCENT&quot;,&quot;percent&quot;:100}" ckplm:commentRequired="true" flowable:formKey="change-notice-countersign" ckplm:formRef="change-notice-countersign">  <multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${ckplmSetupAssignees_cs_plan}" flowable:elementVariable="ckplmApprover"><completionCondition>${nrOfCompletedInstances * 100 &gt;= nrOfInstances * 100 || ckplmVetoed}</completionCondition></multiInstanceLoopCharacteristics></userTask>
    <exclusiveGateway id="gw_ccb" name="是否需要 CCB 决策" ckplm:nodeType="EXCLUSIVE_GATEWAY" default="e11"/>
    <userTask id="cs_ccb" name="CCB 决策会签" ckplm:nodeType="COUNTERSIGN_APPROVAL" flowable:assignee="${ckplmApprover}" ckplm:assignee="{&quot;strategy&quot;:&quot;INITIATOR&quot;}" ckplm:approvalMode="&quot;COUNTERSIGN&quot;" ckplm:passRule="{&quot;mode&quot;:&quot;PERCENT&quot;,&quot;percent&quot;:100}" ckplm:commentRequired="true" flowable:formKey="change-notice-countersign" ckplm:formRef="change-notice-countersign">  <multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${ckplmSetupAssignees_cs_ccb}" flowable:elementVariable="ckplmApprover"><completionCondition>${nrOfCompletedInstances * 100 &gt;= nrOfInstances * 100 || ckplmVetoed}</completionCondition></multiInstanceLoopCharacteristics></userTask>
    <userTask id="approve_plan" name="实施方案审批" ckplm:nodeType="APPROVAL" flowable:assignee="${ckplmSetupAssignees_approve_plan}" ckplm:assignee="{&quot;strategy&quot;:&quot;INITIATOR&quot;}" ckplm:approvalMode="&quot;SINGLE&quot;" ckplm:commentRequired="true" flowable:formKey="change-notice-review" ckplm:formRef="change-notice-review"/>
    <serviceTask id="set_approved" name="审批通过：已批准" ckplm:nodeType="SERVICE" flowable:delegateExpression="${plmServiceDelegate}" ckplm:serviceRef="change.setRequestStatus" ckplm:serviceParams="{&quot;status&quot;:&quot;APPROVED&quot;}">  <extensionElements><flowable:field name="serviceId"><flowable:string>change.setRequestStatus</flowable:string></flowable:field><flowable:field name="status"><flowable:string>APPROVED</flowable:string></flowable:field></extensionElements></serviceTask>
    <serviceTask id="set_rejected" name="审批驳回：已驳回" ckplm:nodeType="SERVICE" flowable:delegateExpression="${plmServiceDelegate}" ckplm:serviceRef="change.setRequestStatus" ckplm:serviceParams="{&quot;status&quot;:&quot;REJECTED&quot;}">  <extensionElements><flowable:field name="serviceId"><flowable:string>change.setRequestStatus</flowable:string></flowable:field><flowable:field name="status"><flowable:string>REJECTED</flowable:string></flowable:field></extensionElements></serviceTask>
    <callActivity id="sub_task" name="派发变更任务（子流程）" ckplm:nodeType="SUB_PROCESS" calledElement="change-task" ckplm:variableMap="{&quot;initiator&quot;:&quot;${initiator}&quot;,&quot;taskAssignee&quot;:&quot;${task.assignee}&quot;}" ckplm:multiInstance="{&quot;collection&quot;:&quot;changeTaskList&quot;,&quot;elementVariable&quot;:&quot;task&quot;,&quot;sequential&quot;:false,&quot;businessKey&quot;:&quot;oid&quot;}" flowable:businessKey="${task.oid}"><extensionElements><flowable:in sourceExpression="${initiator}" target="initiator"/><flowable:in sourceExpression="${task.assignee}" target="taskAssignee"/></extensionElements><multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${changeTaskList}" flowable:elementVariable="task"/></callActivity>
    <endEvent id="end_done" name="结束：变更已实施" ckplm:nodeType="END"/>
    <endEvent id="end_rejected" name="结束：审批驳回" ckplm:nodeType="END"/>
    <sequenceFlow id="e0" sourceRef="start_1" targetRef="set_approving"/>
    <sequenceFlow id="e1" sourceRef="set_approving" targetRef="gw_level"/>
    <sequenceFlow id="e2" sourceRef="gw_level" targetRef="setup_quick" name="快速" ckplm:condition="{&quot;mode&quot;:&quot;FIELD&quot;,&quot;fieldKey&quot;:&quot;changeLevel&quot;,&quot;operator&quot;:&quot;EQ&quot;,&quot;value&quot;:&quot;QUICK&quot;,&quot;valueType&quot;:&quot;STRING&quot;}"><conditionExpression xsi:type="tFormalExpression">${changeLevel == 'QUICK'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e3" sourceRef="gw_level" targetRef="setup_multi" name="标准 / 重大"/>
    <sequenceFlow id="e4" sourceRef="setup_quick" targetRef="approve_quick"/>
    <sequenceFlow id="e5" sourceRef="setup_multi" targetRef="cs_plan"/>
    <sequenceFlow id="e6" sourceRef="approve_quick" targetRef="set_approved" name="通过" ckplm:route="PASS"><conditionExpression xsi:type="tFormalExpression">${approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e7" sourceRef="approve_quick" targetRef="set_rejected" name="驳回" ckplm:route="REJECT"><conditionExpression xsi:type="tFormalExpression">${!approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e8" sourceRef="cs_plan" targetRef="gw_ccb" name="通过" ckplm:route="PASS"><conditionExpression xsi:type="tFormalExpression">${approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e9" sourceRef="cs_plan" targetRef="set_rejected" name="驳回" ckplm:route="REJECT"><conditionExpression xsi:type="tFormalExpression">${!approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e10" sourceRef="gw_ccb" targetRef="cs_ccb" name="重大" ckplm:condition="{&quot;mode&quot;:&quot;FIELD&quot;,&quot;fieldKey&quot;:&quot;changeLevel&quot;,&quot;operator&quot;:&quot;EQ&quot;,&quot;value&quot;:&quot;MAJOR&quot;,&quot;valueType&quot;:&quot;STRING&quot;}"><conditionExpression xsi:type="tFormalExpression">${changeLevel == 'MAJOR'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e11" sourceRef="gw_ccb" targetRef="approve_plan" name="标准"/>
    <sequenceFlow id="e12" sourceRef="cs_ccb" targetRef="set_approved" name="批准" ckplm:route="PASS"><conditionExpression xsi:type="tFormalExpression">${approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e13" sourceRef="cs_ccb" targetRef="set_rejected" name="驳回" ckplm:route="REJECT"><conditionExpression xsi:type="tFormalExpression">${!approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e14" sourceRef="approve_plan" targetRef="set_approved" name="通过" ckplm:route="PASS"><conditionExpression xsi:type="tFormalExpression">${approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e15" sourceRef="approve_plan" targetRef="set_rejected" name="驳回" ckplm:route="REJECT"><conditionExpression xsi:type="tFormalExpression">${!approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e16" sourceRef="set_approved" targetRef="sub_task"/>
    <sequenceFlow id="e17" sourceRef="set_rejected" targetRef="end_rejected"/>
    <sequenceFlow id="e18" sourceRef="sub_task" targetRef="end_done"/>
  </process>
