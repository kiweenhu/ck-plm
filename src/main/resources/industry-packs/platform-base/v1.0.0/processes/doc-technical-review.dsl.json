        "kind": "NORMAL"
      },
      {
        "id": "e3",
        "source": "n_review",
        "target": "service_published",
        "kind": "NORMAL",
        "name": "通过",
        "route": "PASS"
      },
      {
        "id": "e4",
        "source": "n_review",
        "target": "service_draft",
        "kind": "NORMAL",
        "name": "驳回",
        "route": "REJECT"
      },
      {
        "id": "e5",
