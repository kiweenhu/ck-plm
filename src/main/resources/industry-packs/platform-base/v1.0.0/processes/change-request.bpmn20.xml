  <process id="change-request" name="变更请求流程" isExecutable="true">
    <documentation>提出（分级）→ 影响分析会签 → 评审决策；审签路径按变更分级分流。结论自动回写 ECR。</documentation>
    <startEvent id="start_1" name="开始：提出变更请求" ckplm:nodeType="START" flowable:initiator="initiator" ckplm:initiator="{&quot;strategy&quot;:&quot;INITIATOR&quot;}"/>
    <exclusiveGateway id="gw_level" name="按变更分级分流" ckplm:nodeType="EXCLUSIVE_GATEWAY" default="e3"/>
    <userTask id="setup_quick" name="设置快速通道审批人" ckplm:nodeType="SET_ASSIGNEE" flowable:assignee="${initiator}" ckplm:assignee="{&quot;strategy&quot;:&quot;INITIATOR&quot;}" flowable:formKey="CKPLM_SETUP_ASSIGNEE" ckplm:formRef="CKPLM_SETUP_ASSIGNEE"/>
    <userTask id="approve_quick" name="快速审批" ckplm:nodeType="APPROVAL" flowable:assignee="${ckplmSetupAssignees_approve_quick}" ckplm:assignee="{&quot;strategy&quot;:&quot;INITIATOR&quot;}" ckplm:approvalMode="&quot;SINGLE&quot;" ckplm:commentRequired="true" flowable:formKey="CKPLM_APPROVAL_OPINION" ckplm:formRef="CKPLM_APPROVAL_OPINION"/>
    <userTask id="setup_multi" name="设置会签参与人" ckplm:nodeType="SET_ASSIGNEE" flowable:assignee="${initiator}" ckplm:assignee="{&quot;strategy&quot;:&quot;INITIATOR&quot;}" flowable:formKey="CKPLM_SETUP_ASSIGNEE" ckplm:formRef="CKPLM_SETUP_ASSIGNEE"/>
    <userTask id="cs_impact" name="影响分析会签" ckplm:nodeType="COUNTERSIGN_APPROVAL" flowable:assignee="${ckplmApprover}" ckplm:assignee="{&quot;strategy&quot;:&quot;INITIATOR&quot;}" ckplm:approvalMode="&quot;COUNTERSIGN&quot;" ckplm:passRule="{&quot;mode&quot;:&quot;PERCENT&quot;,&quot;percent&quot;:100}" ckplm:commentRequired="true" flowable:formKey="change-request-impact" ckplm:formRef="change-request-impact">  <multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${ckplmSetupAssignees_cs_impact}" flowable:elementVariable="ckplmApprover"><completionCondition>${nrOfCompletedInstances * 100 &gt;= nrOfInstances * 100 || ckplmVetoed}</completionCondition></multiInstanceLoopCharacteristics></userTask>
    <exclusiveGateway id="gw_ccb" name="是否需要 CCB 决策" ckplm:nodeType="EXCLUSIVE_GATEWAY" default="e11"/>
    <userTask id="cs_ccb" name="CCB 决策会签" ckplm:nodeType="COUNTERSIGN_APPROVAL" flowable:assignee="${ckplmApprover}" ckplm:assignee="{&quot;strategy&quot;:&quot;INITIATOR&quot;}" ckplm:approvalMode="&quot;COUNTERSIGN&quot;" ckplm:passRule="{&quot;mode&quot;:&quot;PERCENT&quot;,&quot;percent&quot;:100}" ckplm:commentRequired="true" flowable:formKey="change-request-ccb" ckplm:formRef="change-request-ccb">  <multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${ckplmSetupAssignees_cs_ccb}" flowable:elementVariable="ckplmApprover"><completionCondition>${nrOfCompletedInstances * 100 &gt;= nrOfInstances * 100 || ckplmVetoed}</completionCondition></multiInstanceLoopCharacteristics></userTask>
    <serviceTask id="set_analyzing" name="进入影响分析" ckplm:nodeType="SERVICE" flowable:delegateExpression="${plmServiceDelegate}" ckplm:serviceRef="change.setRequestStatus" ckplm:serviceParams="{&quot;status&quot;:&quot;ANALYZING&quot;}">  <extensionElements><flowable:field name="serviceId"><flowable:string>change.setRequestStatus</flowable:string></flowable:field><flowable:field name="status"><flowable:string>ANALYZING</flowable:string></flowable:field></extensionElements></serviceTask>
    <serviceTask id="set_reviewing_quick" name="进入评审" ckplm:nodeType="SERVICE" flowable:delegateExpression="${plmServiceDelegate}" ckplm:serviceRef="change.setRequestStatus" ckplm:serviceParams="{&quot;status&quot;:&quot;REVIEWING&quot;}">  <extensionElements><flowable:field name="serviceId"><flowable:string>change.setRequestStatus</flowable:string></flowable:field><flowable:field name="status"><flowable:string>REVIEWING</flowable:string></flowable:field></extensionElements></serviceTask>
    <serviceTask id="set_reviewing" name="影响分析通过：进入评审" ckplm:nodeType="SERVICE" flowable:delegateExpression="${plmServiceDelegate}" ckplm:serviceRef="change.setRequestStatus" ckplm:serviceParams="{&quot;status&quot;:&quot;REVIEWING&quot;}">  <extensionElements><flowable:field name="serviceId"><flowable:string>change.setRequestStatus</flowable:string></flowable:field><flowable:field name="status"><flowable:string>REVIEWING</flowable:string></flowable:field></extensionElements></serviceTask>
    <serviceTask id="set_accepted" name="评审通过：已受理" ckplm:nodeType="SERVICE" flowable:delegateExpression="${plmServiceDelegate}" ckplm:serviceRef="change.setRequestStatus" ckplm:serviceParams="{&quot;status&quot;:&quot;ACCEPTED&quot;}">  <extensionElements><flowable:field name="serviceId"><flowable:string>change.setRequestStatus</flowable:string></flowable:field><flowable:field name="status"><flowable:string>ACCEPTED</flowable:string></flowable:field></extensionElements></serviceTask>
    <serviceTask id="set_rejected" name="评审驳回：已否决" ckplm:nodeType="SERVICE" flowable:delegateExpression="${plmServiceDelegate}" ckplm:serviceRef="change.setRequestStatus" ckplm:serviceParams="{&quot;status&quot;:&quot;REJECTED&quot;}">  <extensionElements><flowable:field name="serviceId"><flowable:string>change.setRequestStatus</flowable:string></flowable:field><flowable:field name="status"><flowable:string>REJECTED</flowable:string></flowable:field></extensionElements></serviceTask>
    <endEvent id="end_accepted" name="结束：评审通过" ckplm:nodeType="END"/>
    <endEvent id="end_rejected" name="结束：评审驳回" ckplm:nodeType="END"/>
    <sequenceFlow id="e1" sourceRef="start_1" targetRef="gw_level"/>
    <sequenceFlow id="e2" sourceRef="gw_level" targetRef="set_reviewing_quick" name="快速" ckplm:condition="{&quot;mode&quot;:&quot;FIELD&quot;,&quot;fieldKey&quot;:&quot;changeLevel&quot;,&quot;operator&quot;:&quot;EQ&quot;,&quot;value&quot;:&quot;QUICK&quot;,&quot;valueType&quot;:&quot;STRING&quot;}"><conditionExpression xsi:type="tFormalExpression">${changeLevel == 'QUICK'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e3" sourceRef="gw_level" targetRef="set_analyzing" name="标准 / 重大"/>
    <sequenceFlow id="e14" sourceRef="set_reviewing_quick" targetRef="setup_quick"/>
    <sequenceFlow id="e15" sourceRef="set_analyzing" targetRef="setup_multi"/>
    <sequenceFlow id="e4" sourceRef="setup_quick" targetRef="approve_quick"/>
    <sequenceFlow id="e5" sourceRef="setup_multi" targetRef="cs_impact"/>
    <sequenceFlow id="e6" sourceRef="approve_quick" targetRef="set_accepted" name="通过" ckplm:route="PASS"><conditionExpression xsi:type="tFormalExpression">${approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e7" sourceRef="approve_quick" targetRef="set_rejected" name="驳回" ckplm:route="REJECT"><conditionExpression xsi:type="tFormalExpression">${!approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e8" sourceRef="cs_impact" targetRef="set_reviewing" name="通过" ckplm:route="PASS"><conditionExpression xsi:type="tFormalExpression">${approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e9" sourceRef="cs_impact" targetRef="set_rejected" name="驳回" ckplm:route="REJECT"><conditionExpression xsi:type="tFormalExpression">${!approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e10" sourceRef="gw_ccb" targetRef="cs_ccb" name="重大" ckplm:condition="{&quot;mode&quot;:&quot;FIELD&quot;,&quot;fieldKey&quot;:&quot;changeLevel&quot;,&quot;operator&quot;:&quot;EQ&quot;,&quot;value&quot;:&quot;MAJOR&quot;,&quot;valueType&quot;:&quot;STRING&quot;}"><conditionExpression xsi:type="tFormalExpression">${changeLevel == 'MAJOR'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e11" sourceRef="gw_ccb" targetRef="set_accepted" name="标准"/>
    <sequenceFlow id="e12" sourceRef="cs_ccb" targetRef="set_accepted" name="批准" ckplm:route="PASS"><conditionExpression xsi:type="tFormalExpression">${approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e13" sourceRef="cs_ccb" targetRef="set_rejected" name="驳回" ckplm:route="REJECT"><conditionExpression xsi:type="tFormalExpression">${!approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e16" sourceRef="set_reviewing" targetRef="gw_ccb"/>
    <sequenceFlow id="e17" sourceRef="set_accepted" targetRef="end_accepted"/>
    <sequenceFlow id="e18" sourceRef="set_rejected" targetRef="end_rejected"/>
  </process>
