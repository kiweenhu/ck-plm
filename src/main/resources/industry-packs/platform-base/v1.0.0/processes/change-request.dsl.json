{
  "key": "change-request",
  "name": "变更请求流程",
  "displayName": "变更请求（ECR）流程",
  "category": "变更管理",
  "description": "变更请求（ECR）主流程：提出请求 → 设置评审人 → 变更评审 → 通过后按清单派发变更通告（1:M 子流程）→ 全部通告结束后闭环；驳回则结束。变更通告（change-notice）是本流程的子流程，变更任务（change-task）是通告的子流程，三层形成「请求 → 通告 → 任务」的父子链路。",
  "enabled": true,
  "dsl": {
    "dslVersion": "1.0",
    "meta": {
      "key": "change-request",
      "name": "变更请求流程",
      "displayName": "变更请求（ECR）流程",
      "category": "变更管理",
      "description": "提出（分级）→ 影响分析会签 → 评审决策；审签路径按变更分级分流。结论自动回写 ECR。",
      "notifications": {
        "channel": "CK_PLM"
      }
    },
    "variables": [],
    "nodes": [
      {
        "id": "start_1",
        "name": "开始：提出变更请求",
        "description": "由变更请求（ECR）的「发起评审」动作拉起，业务标识 = ECR oid；分级与影响评估随流程变量带入",
        "type": "START",
        "initiator": {
          "strategy": "INITIATOR"
        }
      },
      {
        "id": "gw_level",
        "name": "按变更分级分流",
        "description": "快速变更只需一次单人对口审批，不必占会签的人力；标准与重大都要先过跨职能影响分析",
        "type": "EXCLUSIVE_GATEWAY"
      },
      {
        "id": "setup_quick",
        "name": "设置快速通道审批人",
        "description": "快速变更只有这一个审批环节，发起人在此指定审批人",
        "type": "SET_ASSIGNEE",
        "assignee": {
          "strategy": "INITIATOR"
        },
        "formRef": "CKPLM_SETUP_ASSIGNEE"
      },
      {
        "id": "approve_quick",
        "name": "快速审批",
        "description": "单人对口审批：确认改动范围与风险都在可接受范围内；意见必填",
        "type": "APPROVAL",
        "assignee": {
          "strategy": "INITIATOR"
        },
        "approvalMode": "SINGLE",
        "commentRequired": true,
        "formRef": "CKPLM_APPROVAL_OPINION"
      },
      {
        "id": "setup_multi",
        "name": "设置会签参与人",
        "description": "标准 / 重大变更需要跨职能参与：在此指定影响分析会签成员（重大时再指定 CCB 成员）",
        "type": "SET_ASSIGNEE",
        "assignee": {
          "strategy": "INITIATOR"
        },
        "formRef": "CKPLM_SETUP_ASSIGNEE"
      },
      {
        "id": "cs_impact",
        "name": "影响分析会签",
        "description": "硬件 / 工艺 / 质量 / 采购等按各自视角确认受影响对象、认证与客户影响、在制库存处置；全票通过才进入决策，任一反对即驳回",
        "type": "COUNTERSIGN_APPROVAL",
        "assignee": {
          "strategy": "ROLE",
          "roleCodes": [
            "HARDWARE_LEAD",
            "PROCESS_ENGINEER",
            "QUALITY_ENGINEER",
            "SOURCING_ENGINEER",
            "COMPANY_LEADER",
            "PRODUCT_MANAGER"
          ]
        },
        "passRule": {
          "mode": "PERCENT",
          "percent": 100
        },
        "commentRequired": true,
        "formRef": "change-request-impact"
      },
      {
        "id": "gw_ccb",
        "name": "是否需要 CCB 决策",
        "description": "重大变更（影响已发布产品 / 认证 / 客户合同）必须由 CCB 集体决策；标准变更由产品经理收口",
        "type": "EXCLUSIVE_GATEWAY"
      },
      {
        "id": "cs_ccb",
        "name": "CCB 决策会签",
        "description": "变更控制委员会集体决策：批准、有条件批准、驳回；条件与生效方式写进意见，全票通过方为批准",
        "type": "COUNTERSIGN_APPROVAL",
        "assignee": {
          "strategy": "ROLE",
          "roleCodes": [
            "COMPANY_LEADER",
            "HARDWARE_ENGINEER",
            "COMPONENT_ENGINEER",
            "PROCESS_ENGINEER",
            "NPI_ENGINEER",
            "ME_ENGINEER",
            "QUALITY_ENGINEER",
            "SYSTEM_ENGINEER",
            "SOURCING_ENGINEER"
          ]
        },
        "passRule": {
          "mode": "PERCENT",
          "percent": 100
        },
        "commentRequired": true,
        "formRef": "change-request-ccb"
      },
      {
        "id": "set_analyzing",
        "name": "进入影响分析",
        "description": "单据状态置为「影响分析中」（ANALYZING）：标准 / 重大变更的跨职能影响评估在此阶段完成",
        "type": "SERVICE",
        "serviceRef": "change.setRequestStatus",
        "params": {
          "status": "ANALYZING"
        }
      },
      {
        "id": "set_reviewing_quick",
        "name": "进入评审",
        "description": "快速变更不经过影响分析，发起后直接进入「评审中」（REVIEWING）",
        "type": "SERVICE",
        "serviceRef": "change.setRequestStatus",
        "params": {
          "status": "REVIEWING"
        }
      },
      {
        "id": "set_reviewing",
        "name": "影响分析通过：进入评审",
        "description": "影响分析会签全票通过后，单据状态置为「评审中」（REVIEWING），进入决策环节",
        "type": "SERVICE",
        "serviceRef": "change.setRequestStatus",
        "params": {
          "status": "REVIEWING"
        }
      },
      {
        "id": "set_accepted",
        "name": "评审通过：已受理",
        "description": "单据状态置为「已受理」（ACCEPTED）",
        "type": "SERVICE",
        "serviceRef": "change.setRequestStatus",
        "params": {
          "status": "ACCEPTED"
        }
      },
      {
        "id": "set_rejected",
        "name": "评审驳回：已否决",
        "description": "单据状态置为「已否决」（REJECTED）",
        "type": "SERVICE",
        "serviceRef": "change.setRequestStatus",
        "params": {
          "status": "REJECTED"
        }
      },
      {
        "id": "end_accepted",
        "name": "结束：评审通过",
        "type": "END"
      },
      {
        "id": "end_rejected",
        "name": "结束：评审驳回",
        "type": "END"
      }
    ],
    "edges": [
