{
  "key": "change-task",
  "name": "变更任务流程",
  "displayName": "变更任务（ECT）流程",
  "category": "变更管理",
  "description": "变更任务（ECT）流程：任务下达 → 执行变更任务（办理人由 taskAssignee 变量指定）→ 完成。本流程是变更通告（change-notice）的子流程：一张通告按任务清单 1:M 拉起 N 个实例，全部实例结束后通告才继续，因此通告的关闭天然等待所有任务完成。",
  "enabled": true,
  "dsl": {
    "dslVersion": "1.0",
    "meta": {
      "key": "change-task",
      "name": "变更任务流程",
      "displayName": "变更任务（ECT）流程",
      "category": "变更管理",
      "description": "变更任务（ECT）流程：任务下达 → 执行变更任务 → 完成。办理人取自流程变量 taskAssignee。",
      "notifications": {
        "channel": "CK_PLM"
      }
    },
    "variables": [
      {
        "name": "taskAssignee",
        "label": "任务办理人",
        "type": "STRING",
        "visible": true,
        "readonly": false
      }
    ],
    "nodes": [
      {
        "id": "start_1",
        "name": "开始：任务下达",
        "description": "由变更通告派发时拉起（子流程），业务标识 = 变更任务 oid；任务办理人由 taskAssignee 变量带入",
        "type": "START",
        "initiator": {
          "strategy": "INITIATOR"
        }
      },
      {
        "id": "task_1",
        "name": "执行变更任务",
        "description": "按任务说明完成受影响对象的修订 / 新建 / 作废并提交验收",
        "type": "TASK",
        "assignee": {
          "strategy": "VARIABLE",
          "variableName": "taskAssignee"
        },
        "formRef": "change-task-execute"
      },
      {
        "id": "end_1",
        "name": "结束：任务完成",
        "type": "END"
      },
      {
        "id": "set_assignee_dw129e",
        "name": "变更结果提交审批",
        "type": "SET_ASSIGNEE",
        "assignee": {
          "strategy": "VARIABLE",
          "variableName": "taskAssignee"
        },
        "formRef": "change-task-approve-setup"
      },
      {
        "id": "countersign_approval_g8tm23",
        "name": "会签审批",
        "type": "COUNTERSIGN_APPROVAL",
        "assignee": {
          "strategy": "ROLE",
          "roleCodes": [
            "PRODUCT_MANAGER",
            "QUALITY_ENGINEER",
            "HARDWARE_LEAD"
          ]
        },
        "passRule": {
          "mode": "PERCENT",
          "percent": 100,
          "abstain": "IGNORE"
        },
        "formRef": "change-task-countersign"
      },
      {
        "id": "approval_87zopm",
        "name": "领导审批",
        "type": "APPROVAL",
        "assignee": {
          "strategy": "ROLE",
          "roleCodes": [
            "COMPANY_LEADER"
          ]
        },
        "approvalMode": "SINGLE",
        "formRef": "change-task-approval"
      },
      {
        "id": "service_kyhaza",
        "name": "任务结项",
        "type": "SERVICE",
        "serviceRef": "change.completeTask"
      },
      {
        "id": "service_i1hxoq",
        "name": "修订后的对象：评审中",
        "type": "SERVICE",
        "serviceRef": "object.setLifecycleState",
        "params": {
          "state": "REVIEWING"
        }
      },
      {
        "id": "service_z3oh5k",
        "name": "修订后的对象：已发布",
        "type": "SERVICE",
        "serviceRef": "object.setLifecycleState",
        "params": {
          "state": "PUBLISHED"
        }
      }
    ],
