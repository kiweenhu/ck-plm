<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:ckplm="http://www.ck.com/plm/workflow/dsl"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath"
             targetNamespace="http://www.ck.com/plm/workflow">
  <process id="change-notice" name="变更通告流程（仅 ECN）" isExecutable="true">
    <documentation>独立变更通告：影响面评审 → 变更审批 → 变更管理员终审 → 派发变更任务。</documentation>
    <startEvent id="start_1" name="开始：发起变更通告" ckplm:nodeType="START" flowable:initiator="initiator" ckplm:initiator="{&quot;strategy&quot;:&quot;INITIATOR&quot;}"/>
    <serviceTask id="set_approving" name="进入审批：审批中" ckplm:nodeType="SERVICE" flowable:delegateExpression="${plmServiceDelegate}" ckplm:serviceRef="change.setRequestStatus" ckplm:serviceParams="{&quot;status&quot;:&quot;APPROVING&quot;}">  <extensionElements><flowable:field name="serviceId"><flowable:string>change.setRequestStatus</flowable:string></flowable:field><flowable:field name="status"><flowable:string>APPROVING</flowable:string></flowable:field></extensionElements></serviceTask>
    <userTask id="setup_1" name="设置审批人" ckplm:nodeType="SET_ASSIGNEE" flowable:assignee="${initiator}" ckplm:assignee="{&quot;strategy&quot;:&quot;INITIATOR&quot;}" flowable:formKey="CKPLM_SETUP_ASSIGNEE" ckplm:formRef="CKPLM_SETUP_ASSIGNEE"/>
    <userTask id="assess_1" name="部门审批" ckplm:nodeType="APPROVAL" flowable:assignee="${ckplmSetupAssignees_assess_1}" ckplm:assignee="{&quot;strategy&quot;:&quot;ROLE&quot;,&quot;roleCodes&quot;:[&quot;COMPANY_LEADER&quot;]}" ckplm:approvalMode="&quot;SINGLE&quot;" ckplm:commentRequired="true" flowable:formKey="change-notice-review" ckplm:formRef="change-notice-review"/>
    <userTask id="final_1" name="领导审批" ckplm:nodeType="APPROVAL" flowable:assignee="${ckplmSetupAssignees_final_1}" ckplm:assignee="{&quot;strategy&quot;:&quot;INITIATOR_LEADER&quot;}" ckplm:approvalMode="&quot;SINGLE&quot;" ckplm:commentRequired="true" flowable:formKey="change-notice-review" ckplm:formRef="change-notice-review"/>
    <serviceTask id="set_approved" name="审批通过：已批准" ckplm:nodeType="SERVICE" flowable:delegateExpression="${plmServiceDelegate}" ckplm:serviceRef="change.setRequestStatus" ckplm:serviceParams="{&quot;status&quot;:&quot;APPROVED&quot;}">  <extensionElements><flowable:field name="serviceId"><flowable:string>change.setRequestStatus</flowable:string></flowable:field><flowable:field name="status"><flowable:string>APPROVED</flowable:string></flowable:field></extensionElements></serviceTask>
    <serviceTask id="set_rejected" name="审批驳回：已驳回" ckplm:nodeType="SERVICE" flowable:delegateExpression="${plmServiceDelegate}" ckplm:serviceRef="change.setRequestStatus" ckplm:serviceParams="{&quot;status&quot;:&quot;REJECTED&quot;}">  <extensionElements><flowable:field name="serviceId"><flowable:string>change.setRequestStatus</flowable:string></flowable:field><flowable:field name="status"><flowable:string>REJECTED</flowable:string></flowable:field></extensionElements></serviceTask>
    <callActivity id="sub_task" name="变更任务自动分发（子流程）" ckplm:nodeType="SUB_PROCESS" calledElement="change-task" ckplm:variableMap="{&quot;initiator&quot;:&quot;${initiator}&quot;,&quot;taskAssignee&quot;:&quot;${task.assignee}&quot;}" ckplm:multiInstance="{&quot;collection&quot;:&quot;changeTaskList&quot;,&quot;elementVariable&quot;:&quot;task&quot;,&quot;sequential&quot;:false,&quot;businessKey&quot;:&quot;oid&quot;}" flowable:businessKey="${task.oid}"><extensionElements><flowable:in sourceExpression="${initiator}" target="initiator"/><flowable:in sourceExpression="${task.assignee}" target="taskAssignee"/></extensionElements><multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${changeTaskList}" flowable:elementVariable="task"/></callActivity>
    <endEvent id="end_done" name="结束：变更已实施" ckplm:nodeType="END"/>
    <endEvent id="end_rejected" name="结束：审批驳回" ckplm:nodeType="END"/>
    <userTask id="countersign_approval_vynph8" name="专业会签" ckplm:nodeType="COUNTERSIGN_APPROVAL" flowable:assignee="${ckplmApprover}" ckplm:assignee="{&quot;strategy&quot;:&quot;ROLE&quot;,&quot;roleCodes&quot;:[&quot;HARDWARE_ENGINEER&quot;,&quot;ME_ENGINEER&quot;,&quot;NPI_ENGINEER&quot;,&quot;PROCESS_ENGINEER&quot;,&quot;QUALITY_ENGINEER&quot;,&quot;SW_ENGINEER&quot;,&quot;SYSTEM_ENGINEER&quot;]}" ckplm:approvalMode="&quot;COUNTERSIGN&quot;" ckplm:passRule="{&quot;mode&quot;:&quot;PERCENT&quot;,&quot;percent&quot;:100,&quot;abstain&quot;:&quot;IGNORE&quot;}" ckplm:commentRequired="true" flowable:formKey="change-notice-countersign" ckplm:formRef="change-notice-countersign">  <multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${ckplmSetupAssignees_countersign_approval_vynph8}" flowable:elementVariable="ckplmApprover"><completionCondition>${nrOfCompletedInstances * 100 &gt;= nrOfInstances * 100 || ckplmVetoed}</completionCondition></multiInstanceLoopCharacteristics></userTask>
    <userTask id="task_04ujp3" name="变更任务确认与派发" ckplm:nodeType="TASK" flowable:candidateUsers="${ckplmSetupAssignees_task_04ujp3}" ckplm:assignee="{&quot;strategy&quot;:&quot;INITIATOR&quot;}" flowable:formKey="change-notice-task-plan" ckplm:formRef="change-notice-task-plan"/>
    <userTask id="task_m4m0gx" name="变更结果汇总确认" ckplm:nodeType="TASK" flowable:candidateUsers="${ckplmSetupAssignees_task_m4m0gx}" ckplm:assignee="{&quot;strategy&quot;:&quot;ROLE&quot;,&quot;roleCodes&quot;:[&quot;HARDWARE_ENGINEER&quot;,&quot;HARDWARE_LEAD&quot;]}" flowable:formKey="change-notice-task-summary" ckplm:formRef="change-notice-task-summary"/>
    <serviceTask id="service_lhc8qn" name="实施完成" ckplm:nodeType="SERVICE" flowable:delegateExpression="${plmServiceDelegate}" ckplm:serviceRef="change.completeNotice">  <extensionElements><flowable:field name="serviceId"><flowable:string>change.completeNotice</flowable:string></flowable:field></extensionElements></serviceTask>
    <serviceTask id="service_4ltyld" name="任务已派发：实施中" ckplm:nodeType="SERVICE" flowable:delegateExpression="${plmServiceDelegate}" ckplm:serviceRef="change.setRequestStatus" ckplm:serviceParams="{&quot;status&quot;:&quot;IN_WORK&quot;}">  <extensionElements><flowable:field name="serviceId"><flowable:string>change.setRequestStatus</flowable:string></flowable:field><flowable:field name="status"><flowable:string>IN_WORK</flowable:string></flowable:field></extensionElements></serviceTask>
    <sequenceFlow id="e1" sourceRef="start_1" targetRef="set_approving"/>
    <sequenceFlow id="e2" sourceRef="set_approving" targetRef="setup_1"/>
    <sequenceFlow id="e3" sourceRef="setup_1" targetRef="assess_1"/>
    <sequenceFlow id="e4" sourceRef="assess_1" targetRef="countersign_approval_vynph8" name="通过" ckplm:route="PASS"><conditionExpression xsi:type="tFormalExpression">${approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e5" sourceRef="assess_1" targetRef="set_rejected" name="驳回" ckplm:route="REJECT"><conditionExpression xsi:type="tFormalExpression">${!approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e6" sourceRef="countersign_approval_vynph8" targetRef="final_1" name="通过" ckplm:route="PASS"><conditionExpression xsi:type="tFormalExpression">${approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e8" sourceRef="final_1" targetRef="set_approved" name="通过" ckplm:route="PASS"><conditionExpression xsi:type="tFormalExpression">${approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e9" sourceRef="final_1" targetRef="set_rejected" name="驳回" ckplm:route="REJECT"><conditionExpression xsi:type="tFormalExpression">${!approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e11" sourceRef="set_rejected" targetRef="end_rejected"/>
    <sequenceFlow id="flow_1" sourceRef="countersign_approval_vynph8" targetRef="set_rejected" ckplm:route="REJECT"><conditionExpression xsi:type="tFormalExpression">${!approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="flow_2" sourceRef="set_approved" targetRef="task_04ujp3"/>
    <sequenceFlow id="flow_5" sourceRef="task_m4m0gx" targetRef="service_lhc8qn"/>
    <sequenceFlow id="flow_6" sourceRef="service_lhc8qn" targetRef="end_done"/>
    <sequenceFlow id="flow_3" sourceRef="task_04ujp3" targetRef="service_4ltyld"/>
    <sequenceFlow id="flow_4" sourceRef="service_4ltyld" targetRef="sub_task"/>
    <sequenceFlow id="flow_7" sourceRef="sub_task" targetRef="task_m4m0gx"/>
  </process>
