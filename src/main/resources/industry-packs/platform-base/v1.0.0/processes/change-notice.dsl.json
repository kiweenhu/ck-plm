{
  "key": "change-notice",
  "name": "变更通告流程",
  "displayName": "变更通告（ECN）流程",
  "category": "变更管理",
  "description": "变更通告（ECN）流程：发起 → 设置审批人 → 变更审批 → 通过后按清单派发变更任务（1:M 子流程）→ 全部任务完成后结束；驳回则结束。本流程既可作为变更请求（change-request）的子流程被 1:M 调用，也可独立发起（独立变更通告）。",
  "enabled": true,
  "dsl": {
    "dslVersion": "1.0",
    "meta": {
      "key": "change-notice",
      "name": "变更通告流程（仅 ECN）",
      "displayName": "变更通告（ECN）流程 · 独立发起",
      "category": "变更管理",
      "description": "独立变更通告：影响面评审 → 变更审批 → 变更管理员终审 → 派发变更任务。",
      "notifications": {
        "channel": "CK_PLM"
      }
    },
    "variables": [],
    "nodes": [
      {
        "id": "start_1",
        "name": "开始：发起变更通告",
        "description": "由变更通告（ECN）的「提交审批」拉起（businessKey = 通告 oid）",
        "type": "START",
        "initiator": {
          "strategy": "INITIATOR"
        }
      },
      {
        "id": "set_approving",
        "name": "进入审批：审批中",
        "description": "单据状态置为「审批中」（APPROVING）：流程一拉起就落到这个状态，审批人在单据上看到的是「审批中」而不是还停在草稿",
        "type": "SERVICE",
        "serviceRef": "change.setRequestStatus",
        "params": {
          "status": "APPROVING"
        }
      },
      {
        "id": "setup_1",
        "name": "设置审批人",
        "description": "发起人按节点指定本次审批的三级人员（覆盖下游静态人员）",
        "type": "SET_ASSIGNEE",
        "assignee": {
          "strategy": "INITIATOR"
        },
        "formRef": "CKPLM_SETUP_ASSIGNEE"
      },
      {
        "id": "assess_1",
        "name": "部门审批",
        "description": "没有 ECR 的前置分析，这一关替代它：BOM 与受影响对象影响面、供应与在制库存、认证是否需重测（电子：替代料准入与可靠性；智能硬件：跨域一致性与试产切换）、客户通知义务是否触发。意见必填",
        "type": "APPROVAL",
        "assignee": {
          "strategy": "ROLE",
          "roleCodes": [
            "COMPANY_LEADER"
          ]
        },
        "approvalMode": "SINGLE",
        "commentRequired": true,
        "formRef": "change-notice-review"
      },
      {
        "id": "final_1",
        "name": "领导审批",
        "description": "变更管理员/项目经理终审：执行计划与实施窗口、切换与回退方案、追溯与关闭判据。通过后派发变更任务",
        "type": "APPROVAL",
        "assignee": {
          "strategy": "INITIATOR_LEADER"
        },
        "approvalMode": "SINGLE",
        "commentRequired": true,
        "formRef": "change-notice-review"
      },
      {
        "id": "set_approved",
        "name": "审批通过：已批准",
        "description": "单据状态置为「已批准」（APPROVED）：变更事项在此刻由待生效转为可执行，随后派发变更任务",
        "type": "SERVICE",
        "serviceRef": "change.setRequestStatus",
        "params": {
          "status": "APPROVED"
        }
      },
      {
        "id": "set_rejected",
        "name": "审批驳回：已驳回",
        "description": "单据状态置为「已驳回」（REJECTED）—— 任一审批环节驳回都汇到这里，结论只写一次",
        "type": "SERVICE",
        "serviceRef": "change.setRequestStatus",
        "params": {
          "status": "REJECTED"
        }
      },
      {
        "id": "sub_task",
        "name": "变更任务自动分发（子流程）",
        "description": "按 changeTaskList 逐个拉起变更任务流程，每个任务一个独立实例（businessKey = 任务 oid）；全部任务完成后本通告才继续",
        "type": "SUB_PROCESS",
        "processKey": "change-task",
        "variableMap": {
          "initiator": "${initiator}",
          "taskAssignee": "${task.assignee}"
        },
        "multiInstance": {
          "collection": "changeTaskList",
          "elementVariable": "task",
          "sequential": false,
          "businessKey": "oid"
        }
      },
      {
        "id": "end_done",
        "name": "结束：变更已实施",
        "type": "END"
      },
      {
        "id": "end_rejected",
        "name": "结束：审批驳回",
        "type": "END"
      },
      {
        "id": "countersign_approval_vynph8",
        "name": "专业会签",
        "type": "COUNTERSIGN_APPROVAL",
        "assignee": {
          "strategy": "ROLE",
          "roleCodes": [
            "HARDWARE_ENGINEER",
            "ME_ENGINEER",
            "NPI_ENGINEER",
            "PROCESS_ENGINEER",
            "QUALITY_ENGINEER",
            "SW_ENGINEER",
            "SYSTEM_ENGINEER"
          ]
        },
        "passRule": {
          "mode": "PERCENT",
          "percent": 100,
          "abstain": "IGNORE"
        },
        "commentRequired": true,
        "formRef": "change-notice-countersign"
      },
      {
        "id": "task_04ujp3",
        "name": "变更任务确认与派发",
        "type": "TASK",
        "assignee": {
          "strategy": "INITIATOR"
        },
        "formRef": "change-notice-task-plan"
      },
      {
        "id": "task_m4m0gx",
        "name": "变更结果汇总确认",
        "type": "TASK",
        "assignee": {
          "strategy": "ROLE",
          "roleCodes": [
            "HARDWARE_ENGINEER",
            "HARDWARE_LEAD"
          ]
        },
        "formRef": "change-notice-task-summary"
      },
      {
        "id": "service_lhc8qn",
        "name": "实施完成",
        "type": "SERVICE",
        "serviceRef": "change.completeNotice"
      },
      {
        "id": "service_4ltyld",
        "name": "任务已派发：实施中",
        "type": "SERVICE",
        "serviceRef": "change.setRequestStatus",
        "params": {
          "status": "IN_WORK"
        }
      }
    ],
