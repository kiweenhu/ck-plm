    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_e6" bpmnElement="e6">
      <omgdi:waypoint x="291" y="390"/>
      <omgdi:waypoint x="623" y="246"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_e7" bpmnElement="e7">
      <omgdi:waypoint x="291" y="483"/>
      <omgdi:waypoint x="291" y="536"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_e8" bpmnElement="e8">
      <omgdi:waypoint x="623" y="290"/>
      <omgdi:waypoint x="659" y="446"/>
    </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
