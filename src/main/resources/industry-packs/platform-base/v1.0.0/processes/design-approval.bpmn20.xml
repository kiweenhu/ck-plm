    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_service_draft" bpmnElement="service_draft">
      <omgdc:Bounds x="552" y="246" width="142" height="44"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_end_pass" bpmnElement="end_pass">
      <omgdc:Bounds x="276" y="536" width="30" height="30"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_end_reject" bpmnElement="end_reject">
      <omgdc:Bounds x="644" y="446" width="30" height="30"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Edge_e0" bpmnElement="e0">
      <omgdi:waypoint x="291" y="22"/>
      <omgdi:waypoint x="291" y="66"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_e1" bpmnElement="e1">
      <omgdi:waypoint x="291" y="110"/>
      <omgdi:waypoint x="291" y="156"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_e2" bpmnElement="e2">
