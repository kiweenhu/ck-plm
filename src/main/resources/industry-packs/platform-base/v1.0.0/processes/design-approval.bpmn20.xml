<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:ckplm="http://www.ck.com/plm/workflow/dsl"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath"
             targetNamespace="http://www.ck.com/plm/workflow">
  <process id="design-approval" name="设计审批流程" isExecutable="true">
    <documentation>结构件设计与工程数据审批：设置参与者 → 进入工作中 → 领导审批 → 设计会签 → 通过发布 / 驳回退回草稿。</documentation>
    <startEvent id="start_1" name="开始：发起设计审批" ckplm:nodeType="START" flowable:initiator="initiator" ckplm:initiator="{&quot;strategy&quot;:&quot;INITIATOR&quot;}"/>
    <userTask id="setup_1" name="设置参与者" ckplm:nodeType="SET_ASSIGNEE" flowable:assignee="${initiator}" ckplm:assignee="{&quot;strategy&quot;:&quot;INITIATOR&quot;}" flowable:formKey="CKPLM_SETUP_ASSIGNEE" ckplm:formRef="CKPLM_SETUP_ASSIGNEE"/>
    <serviceTask id="service_working" name="进入审批：工作中" ckplm:nodeType="SERVICE" flowable:delegateExpression="${plmServiceDelegate}" ckplm:serviceRef="object.setLifecycleState" ckplm:serviceParams="{&quot;state&quot;:&quot;WORKING&quot;}">  <extensionElements><flowable:field name="serviceId"><flowable:string>object.setLifecycleState</flowable:string></flowable:field><flowable:field name="state"><flowable:string>WORKING</flowable:string></flowable:field></extensionElements></serviceTask>
    <userTask id="approve_leader" name="领导审批" ckplm:nodeType="APPROVAL" flowable:assignee="${ckplmSetupAssignees_approve_leader}" ckplm:assignee="{&quot;strategy&quot;:&quot;INITIATOR_LEADER&quot;}" ckplm:approvalMode="&quot;SINGLE&quot;" ckplm:commentRequired="true"/>
    <userTask id="countersign_design" name="设计会签" ckplm:nodeType="COUNTERSIGN_APPROVAL" flowable:assignee="${ckplmApprover}" ckplm:assignee="{&quot;strategy&quot;:&quot;ROLE&quot;,&quot;roleCodes&quot;:[&quot;SYSTEM_ENGINEER&quot;,&quot;QUALITY_ENGINEER&quot;,&quot;PROJECT_MANAGER&quot;]}" ckplm:approvalMode="&quot;COUNTERSIGN&quot;" ckplm:passRule="{&quot;mode&quot;:&quot;PERCENT&quot;,&quot;percent&quot;:100,&quot;abstain&quot;:&quot;IGNORE&quot;}" ckplm:commentRequired="true">  <multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${ckplmSetupAssignees_countersign_design}" flowable:elementVariable="ckplmApprover"><completionCondition>${nrOfCompletedInstances * 100 &gt;= nrOfInstances * 100 || ckplmVetoed}</completionCondition></multiInstanceLoopCharacteristics></userTask>
    <serviceTask id="service_published" name="审批通过：发布" ckplm:nodeType="SERVICE" flowable:delegateExpression="${plmServiceDelegate}" ckplm:serviceRef="object.setLifecycleState" ckplm:serviceParams="{&quot;state&quot;:&quot;PUBLISHED&quot;}">  <extensionElements><flowable:field name="serviceId"><flowable:string>object.setLifecycleState</flowable:string></flowable:field><flowable:field name="state"><flowable:string>PUBLISHED</flowable:string></flowable:field></extensionElements></serviceTask>
    <serviceTask id="service_draft" name="审批驳回：退回草稿" ckplm:nodeType="SERVICE" flowable:delegateExpression="${plmServiceDelegate}" ckplm:serviceRef="object.setLifecycleState" ckplm:serviceParams="{&quot;state&quot;:&quot;DRAFT&quot;}">  <extensionElements><flowable:field name="serviceId"><flowable:string>object.setLifecycleState</flowable:string></flowable:field><flowable:field name="state"><flowable:string>DRAFT</flowable:string></flowable:field></extensionElements></serviceTask>
    <endEvent id="end_pass" name="结束：设计已发布" ckplm:nodeType="END"/>
    <endEvent id="end_reject" name="结束：已退回草稿" ckplm:nodeType="END"/>
    <sequenceFlow id="e0" sourceRef="start_1" targetRef="setup_1"/>
    <sequenceFlow id="e1" sourceRef="setup_1" targetRef="service_working"/>
    <sequenceFlow id="e2" sourceRef="service_working" targetRef="approve_leader"/>
    <sequenceFlow id="e3" sourceRef="approve_leader" targetRef="countersign_design" name="通过" ckplm:route="PASS"><conditionExpression xsi:type="tFormalExpression">${approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e4" sourceRef="approve_leader" targetRef="service_draft" name="驳回" ckplm:route="REJECT"><conditionExpression xsi:type="tFormalExpression">${!approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e5" sourceRef="countersign_design" targetRef="service_published" name="通过" ckplm:route="PASS"><conditionExpression xsi:type="tFormalExpression">${approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e6" sourceRef="countersign_design" targetRef="service_draft" name="驳回" ckplm:route="REJECT"><conditionExpression xsi:type="tFormalExpression">${!approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e7" sourceRef="service_published" targetRef="end_pass"/>
    <sequenceFlow id="e8" sourceRef="service_draft" targetRef="end_reject"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="design-approval">
    <bpmndi:BPMNShape id="Shape_start_1" bpmnElement="start_1">
      <omgdc:Bounds x="276" y="-8" width="30" height="30"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_setup_1" bpmnElement="setup_1">
      <omgdc:Bounds x="220" y="66" width="142" height="44"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_service_working" bpmnElement="service_working">
      <omgdc:Bounds x="220" y="156" width="142" height="44"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_approve_leader" bpmnElement="approve_leader">
      <omgdc:Bounds x="220" y="246" width="142" height="44"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_countersign_design" bpmnElement="countersign_design">
      <omgdc:Bounds x="220" y="346" width="142" height="44"/>
