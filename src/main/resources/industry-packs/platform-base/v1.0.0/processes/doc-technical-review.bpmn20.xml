<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:ckplm="http://www.ck.com/plm/workflow/dsl"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath"
             targetNamespace="http://www.ck.com/plm/workflow">
  <process id="doc-technical-review" name="技术文档评审流程" isExecutable="true">
    <documentation>技术文档评审流程：发起人设置评审人 → 进入审核中 → 技术评审（会签、一票否决）→ 通过自动发布 / 驳回退回草稿重提。</documentation>
    <startEvent id="start_1" name="开始：发起技术评审" ckplm:nodeType="START" flowable:initiator="initiator" ckplm:initiator="{&quot;strategy&quot;:&quot;INITIATOR&quot;}"/>
    <userTask id="set_assignee_1" name="设置评审人" ckplm:nodeType="SET_ASSIGNEE" flowable:assignee="${initiator}" ckplm:assignee="{&quot;strategy&quot;:&quot;INITIATOR&quot;}" flowable:formKey="CKPLM_SETUP_ASSIGNEE" ckplm:formRef="CKPLM_SETUP_ASSIGNEE"/>
    <serviceTask id="service_approving" name="进入审核中" ckplm:nodeType="SERVICE" flowable:delegateExpression="${plmServiceDelegate}" ckplm:serviceRef="object.setLifecycleState" ckplm:serviceParams="{&quot;state&quot;:&quot;APPROVING&quot;}">  <extensionElements><flowable:field name="serviceId"><flowable:string>object.setLifecycleState</flowable:string></flowable:field><flowable:field name="state"><flowable:string>APPROVING</flowable:string></flowable:field></extensionElements></serviceTask>
    <userTask id="n_review" name="技术评审（会签）" ckplm:nodeType="COUNTERSIGN_APPROVAL" flowable:assignee="${ckplmApprover}" ckplm:assignee="{&quot;strategy&quot;:&quot;ROLE&quot;,&quot;roleCodes&quot;:[&quot;PROJECT_MANAGER&quot;,&quot;SYSTEM_ENGINEER&quot;,&quot;QUALITY_ENGINEER&quot;]}" ckplm:approvalMode="&quot;COUNTERSIGN&quot;" ckplm:passRule="{&quot;mode&quot;:&quot;PERCENT&quot;,&quot;percent&quot;:100}" ckplm:commentRequired="true">  <multiInstanceLoopCharacteristics isSequential="false" flowable:collection="${ckplmSetupAssignees_n_review}" flowable:elementVariable="ckplmApprover"><completionCondition>${nrOfCompletedInstances * 100 &gt;= nrOfInstances * 100 || ckplmVetoed}</completionCondition></multiInstanceLoopCharacteristics></userTask>
    <serviceTask id="service_published" name="评审通过：发布" ckplm:nodeType="SERVICE" flowable:delegateExpression="${plmServiceDelegate}" ckplm:serviceRef="object.setLifecycleState" ckplm:serviceParams="{&quot;state&quot;:&quot;PUBLISHED&quot;}">  <extensionElements><flowable:field name="serviceId"><flowable:string>object.setLifecycleState</flowable:string></flowable:field><flowable:field name="state"><flowable:string>PUBLISHED</flowable:string></flowable:field></extensionElements></serviceTask>
    <serviceTask id="service_draft" name="评审驳回：退回草稿" ckplm:nodeType="SERVICE" flowable:delegateExpression="${plmServiceDelegate}" ckplm:serviceRef="object.setLifecycleState" ckplm:serviceParams="{&quot;state&quot;:&quot;DRAFT&quot;}">  <extensionElements><flowable:field name="serviceId"><flowable:string>object.setLifecycleState</flowable:string></flowable:field><flowable:field name="state"><flowable:string>DRAFT</flowable:string></flowable:field></extensionElements></serviceTask>
    <userTask id="task_resubmit" name="重新提交" ckplm:nodeType="TASK" flowable:assignee="${initiator}" ckplm:assignee="{&quot;strategy&quot;:&quot;INITIATOR&quot;}"/>
    <endEvent id="n_end" name="结束：评审完成" ckplm:nodeType="END"/>
    <sequenceFlow id="e0" sourceRef="start_1" targetRef="set_assignee_1"/>
    <sequenceFlow id="e1" sourceRef="set_assignee_1" targetRef="service_approving"/>
    <sequenceFlow id="e2" sourceRef="service_approving" targetRef="n_review"/>
    <sequenceFlow id="e3" sourceRef="n_review" targetRef="service_published" name="通过" ckplm:route="PASS"><conditionExpression xsi:type="tFormalExpression">${approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e4" sourceRef="n_review" targetRef="service_draft" name="驳回" ckplm:route="REJECT"><conditionExpression xsi:type="tFormalExpression">${!approved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="e5" sourceRef="service_published" targetRef="n_end"/>
    <sequenceFlow id="e6" sourceRef="service_draft" targetRef="task_resubmit"/>
    <sequenceFlow id="e7" sourceRef="task_resubmit" targetRef="service_approving"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="doc-technical-review">
    <bpmndi:BPMNShape id="Shape_start_1" bpmnElement="start_1">
      <omgdc:Bounds x="296" y="-8" width="30" height="30"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_set_assignee_1" bpmnElement="set_assignee_1">
      <omgdc:Bounds x="240" y="66" width="142" height="44"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_service_approving" bpmnElement="service_approving">
      <omgdc:Bounds x="240" y="156" width="142" height="44"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_n_review" bpmnElement="n_review">
      <omgdc:Bounds x="240" y="246" width="142" height="44"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_service_published" bpmnElement="service_published">
      <omgdc:Bounds x="240" y="336" width="142" height="44"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_n_end" bpmnElement="n_end">
      <omgdc:Bounds x="296" y="426" width="30" height="30"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_service_draft" bpmnElement="service_draft">
      <omgdc:Bounds x="576" y="246" width="142" height="44"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_task_resubmit" bpmnElement="task_resubmit">
      <omgdc:Bounds x="540" y="66" width="142" height="44"/>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Edge_e0" bpmnElement="e0">
      <omgdi:waypoint x="311" y="22"/>
      <omgdi:waypoint x="311" y="66"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_e1" bpmnElement="e1">
      <omgdi:waypoint x="311" y="110"/>
      <omgdi:waypoint x="311" y="156"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_e2" bpmnElement="e2">
      <omgdi:waypoint x="311" y="200"/>
      <omgdi:waypoint x="311" y="246"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_e3" bpmnElement="e3">
      <omgdi:waypoint x="311" y="290"/>
      <omgdi:waypoint x="311" y="336"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_e4" bpmnElement="e4">
      <omgdi:waypoint x="311" y="290"/>
      <omgdi:waypoint x="647" y="246"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_e5" bpmnElement="e5">
      <omgdi:waypoint x="311" y="380"/>
      <omgdi:waypoint x="311" y="426"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_e6" bpmnElement="e6">
      <omgdi:waypoint x="647" y="290"/>
      <omgdi:waypoint x="611" y="66"/>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_e7" bpmnElement="e7">
      <omgdi:waypoint x="611" y="110"/>
      <omgdi:waypoint x="311" y="156"/>
    </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
